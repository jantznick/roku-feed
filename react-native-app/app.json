{
  "expo": {
    "name": "We Like Sports",
    "slug": "welikesports",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.welikesports.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-video",
        {
          "supportsBackgroundAudio": true,
          "supportsPictureInPicture": true
        }
      ]
    ],
    "scheme": "welikesports",
    "experiments": {
      "typedRoutes": true
    },
    "cli": {
      "requireCommit": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4406b296-7f81-4164-a059-d67eebaf8f6a"
      }
    }
  }
}
