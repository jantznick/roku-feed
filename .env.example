# Copy to .env and fill in. Full setup guide: docs/LOCAL_SETUP.md
# =============================================================================
# Scraper (repo root)
# =============================================================================

# Backblaze B2 — create an Application Key with read/write on your bucket
# Bucket Settings → S3 Compatible API shows endpoint + region
B2_REGION=us-west-004
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET_NAME=roku-hockey

# Object key for feed JSON in the bucket (not the public URL path — just the key)
# Example: feed.json or roku/feed.json
SECRET_FEED_FILENAME=feed.json

# Optional — skip B2 uploads/deletes; still writes dist/feed.json locally
# DRY_RUN=true

# Optional — use local HTML/sample JSON instead of live sites (see README)
# DEBUG=true

# Optional — write direct CDN m3u8 URLs (no LAN proxy). See docs/PROXY.md
# SKIP_PROXY=true

# Optional — skip onhockey.tv (NHL / NHL Rookie Camp / NCAA / AHL); use Streamed.pk only for hockey
# SKIP_ONHOCKEY=true

# Required on headless servers / Docker (scraper + proxy share this)
PROXY_HEADLESS=true

# Proxy base URL written into feed.json (clients must reach this on your LAN)
PROXY_SERVER=http://192.168.1.50:8787

# LAN host:port used when rewriting m3u8 segment URLs (proxy container / process)
# Same as PROXY_SERVER without the http:// prefix
PROXY_HOST=192.168.1.50:8787

# Optional — host port publish for docker compose (default 8787)
# PROXY_PORT=8787

# Optional — close Chromium when idle for this many ms (proxy only, default 600000)
# PROXY_BROWSER_IDLE_MS=600000

# Optional — verbose proxy logs
# PROXY_DEBUG=true

# =============================================================================
# Notes (not env vars — configure in code or Backblaze UI)
# =============================================================================
# Public feed URL for apps (enable “Friendly URL” on the bucket):
#   https://f004.backblazeb2.com/file/<B2_BUCKET_NAME>/<SECRET_FEED_FILENAME>
#
# HLS proxy behavior: docs/PROXY.md
