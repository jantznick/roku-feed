# Copy to `.env` in this directory before `docker compose up`.

PORT=3001
NODE_ENV=development

# --- How browsers / Roku reach this stack on your LAN ---
# Replace 192.168.1.50 with your home server IP (or hostname).
# For laptop-only testing on the same machine as Compose, localhost is fine.
#
# PUBLIC_API_BASE_URL is baked into the frontend JS at image build time.
# FRONTEND_URL / APP_URL must match the URL you open in the browser (CORS + magic links).

PUBLIC_API_BASE_URL=http://localhost:3001
PUBLIC_FRONTEND_URL=http://localhost:5173

FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Host port for the nginx frontend container (maps to container :80)
FRONTEND_PORT=5173

# Cookie sessions
SESSION_SECRET=change-me-to-a-long-random-string
# COOKIE_DOMAIN=.example.com

# Resend (optional in development — links/codes print to the API console)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Roku Feed <onboarding@resend.dev>

# Default content feed when a user has not set a custom URL
DEFAULT_FEED_URL=https://f004.backblazeb2.com/file/roku-hockey/secretfeedfilename.json

# Used automatically by docker compose for the api service:
# DATABASE_URL=postgresql://rokufeed:rokufeed@db:5432/roku_feed?schema=public
