<component name="MainLoaderTask" extends="Task">
    <interface>
        <field id="content" type="node" />
        <field id="feedUrl" type="string" />
        <!-- loading | cached | partial | ready | stale | error -->
        <field id="status" type="string" alwaysNotify="true" />
        <field id="message" type="string" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="pkg:/source/feedConfig.brs" />
    <script type="text/brightscript" uri="pkg:/components/tasks/MainLoaderTask.brs" />
</component>
