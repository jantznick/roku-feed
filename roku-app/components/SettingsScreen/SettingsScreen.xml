<?xml version="1.0" encoding="UTF-8"?>
<component name="SettingsScreen" extends="Group" initialFocus="menu">
    <script type="text/brightscript" uri="pkg:/source/feedConfig.brs" />
    <script type="text/brightscript" uri="SettingsScreen.brs" />
    <interface>
        <!-- Set to "reload" when the feed URL changes and content should be refreshed -->
        <field id="feedChanged" type="string" alwaysNotify="true" />
    </interface>
    <children>
        <Label
            id="titleLabel"
            text="Feed Settings"
            width="1120"
            translation="[80, 80]"
            font="font:LargeBoldSystemFont"
        />
        <Label
            id="hintLabel"
            text="Custom feed URLs are stored on this device only."
            width="1120"
            translation="[80, 140]"
            font="font:SmallSystemFont"
        />
        <Label
            id="currentUrlLabel"
            width="1120"
            wrap="true"
            maxLines="3"
            translation="[80, 190]"
            font="font:SmallSystemFont"
        />
        <LabelList
            id="menu"
            translation="[80, 300]"
            itemSize="[800, 48]"
            itemSpacing="[0, 12]"
            numRows="3"
        />
    </children>
</component>
