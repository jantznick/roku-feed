<component name="DetailsScreen" extends="Group" initialFocus="Buttons" xsi:noNamespaceSchemaLocation="https://devtools.web.roku.com/schema/RokuSceneGraph.xsd">
    <script type="text/brightscript" uri="DetailsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <interface>
        <!-- Content fields -->
        <field id="content" type="node" />
        <field id="basetext" type="string" />
        <!-- @WriteOnly  -->
        <!-- Manually focus on desired item. This field must be set after setting the content field. -->
        <field id="jumpToItem" type="integer" onChange="OnJumpToItem" value="0" alwaysNotify="true" />
        <!-- tells what item is currently focused  -->
        <field id="itemFocused" type="integer" alwaysNotify="true" />     
        <field id="buttonSelected" type="integer" alias="buttons.itemSelected" />
    </interface>
    <children>
        <!-- <Label
            id="headerLabel"
            text="We Like Sports"
            width="1280"
            horizAlign="left"
            translation="[80, 60]">
            <Font role="font" size="48" />
        </Label> -->
        <LayoutGroup
            translation="[1166, 154]"
            layoutDirection="horiz"
            horizAlignment="right"
            itemSpacings="[40]">
            <Group>
                <Rectangle
                    width="357"
                    height="201"
                    color="0x00000088"
                    translation="[5, 5]"
                />
                <Poster
                    id="poster"
                    width="357"
                    loadWidth="357"
                    height="201"
                    loadHeight="201"
                    loadDisplayMode="scaleToFit"
                />
                <Label
                    id="titleLabel"
                    width="357"
                    wrap="false"
                    horizAlign="right"
                    translation="[0, 211]"
                />
                <Label
                    id="timeLabel"
                    width="357"
                    wrap="false"
                    horizAlign="right"
                    translation="[0, 241]"
                />
            </Group>
            <Group>
                <LabelList
                    id="buttons"
                    numRows="5"
                    itemSpacing="[0,10]"
                    itemSize="[593, 48]"
                    wrap="false"
                />
                <LayoutGroup
                    itemSpacings="[40]"
                    translation="[0, 280]">
                    <Label
                        id="descriptionLabel"
                        wrap="true"
                        maxLines="6"
                        width="593"
                    />
                    <Label
                        id="releaseLabel"
                        wrap="true"
                        width="593"
                    />
                </LayoutGroup>
            </Group>
        </LayoutGroup>
    </children>
</component>